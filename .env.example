# Optional. If set, state-change and SSL-expiry alerts are emailed via Resend.
# Without it, alerts are still recorded on the monitor and Slack still fires.
RESEND_API_KEY=

# Required together with RESEND_API_KEY. Must be a verified Resend from-address.
# Example: Hey it's down <alerts@yourdomain.com>
ALERT_FROM_EMAIL=

# Optional Stripe Payment Link for founding year ($20 / 12 months).
# If unset, the UI shows "founding $20 — checkout coming" and does not pretend checkout works.
STRIPE_PAYMENT_LINK=

# Optional comma-separated emails treated as founding (10 URLs). Also stored as plan=founding.
# Payment itself is stubbed; this is how an operator marks someone paid without a Stripe webhook.
FOUNDING_EMAILS=
